<Window x:Class="KeyLayer.AppPicker"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an app" Width="500" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,22,28,14">
            <TextBlock Text="Choose an app" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="These apps have a window open right now. Not in the list? Open it first, or click Browse and pick its program file." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,12">
            <StackPanel>
                <ItemsControl x:Name="AppItems" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="10,8"
                                    Margin="0,0,0,2" Click="App_Click" AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <Grid Width="24" Height="24" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding GlyphVisibility}" />
                                        <Image Source="{Binding Icon}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Exe}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoneText" Style="{StaticResource Body}" Margin="6,8,6,0" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No other apps have a window open. Click Browse to pick a program file." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="110" IsCancel="True" />
                <Button HorizontalAlignment="Left" Click="Browse_Click" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                        <TextBlock Text="Browse…" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
