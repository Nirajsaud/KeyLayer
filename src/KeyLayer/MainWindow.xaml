<Window x:Class="KeyLayer.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyLayer"
        Title="KeyLayer" Width="1040" Height="700" MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>

        <!-- Hides a caption when it has no text -->
        <Style x:Key="OptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================ shortcut card -->
        <DataTemplate x:Key="ShortcutCard" DataType="{x:Type local:ShortcutItem}">
            <Border Style="{StaticResource RowCard}" Cursor="Hand" MouseLeftButtonUp="ShortcutCard_Click"
                    ToolTip="Click to edit">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Style="{StaticResource Keycaps}" ItemsSource="{Binding Keys}" MinWidth="110" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="8,0,18,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ActionGlyph}" FontSize="14" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding ActionText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource OptionalCaption}" Text="{Binding Details}" Margin="24,3,0,0" />
                        <TextBlock Style="{StaticResource OptionalCaption}" Text="{Binding Warning}" Margin="24,3,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>

                    <Border Grid.Column="3" Style="{StaticResource Badge}" Margin="16,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding KeyboardText}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>

                    <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                              VerticalAlignment="Center" Margin="4,0,10,0"
                              ToolTip="Turn this shortcut on or off" AutomationProperties.Name="Shortcut on" />
                    <Button Grid.Column="5" Style="{StaticResource SubtleButton}" Click="ShortcutMenu_Click"
                            ToolTip="More options" AutomationProperties.Name="More options">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================================ keyboard card -->
        <DataTemplate x:Key="KeyboardCard" DataType="{x:Type local:KeyboardItem}">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border x:Name="Live" Grid.Column="2" Style="{StaticResource Badge}" Margin="12,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                        <TextBlock Text="Typing now" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="Last" Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding LastUsed}"
                               Margin="12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Click="RenameKeyboard_Click"
                            ToolTip="Give this keyboard a name you'll recognise">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" FontSize="14" />
                            <TextBlock Text="Rename" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Live" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Last" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================================ test keys row -->
        <DataTemplate x:Key="EventRow" DataType="{x:Type local:EventItem}">
            <Border Style="{StaticResource RowCard}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EventKeys" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Time}" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" Style="{StaticResource Keycaps}" ItemsSource="{Binding Keys}" MinWidth="90" />
                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="from" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="{Binding Kind, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Code, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="Action" Grid.Column="3" Style="{StaticResource SubtleButton}" Click="MakeShortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ActionIcon" Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                            <TextBlock x:Name="ActionText" Text="Make shortcut" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                    <Setter TargetName="ActionIcon" Property="Text" Value="&#xE70F;" />
                    <Setter TargetName="ActionText" Property="Text" Value="{Binding MappedTo}" />
                    <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Action" Property="ToolTip" Value="This key already has a shortcut. Click to edit it." />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================================ settings row -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="66" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= navigation -->
        <DockPanel Margin="10,14,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,2,0,22">
                <Image Source="pack://application:,,,/app.ico" Width="26" Height="26" />
                <TextBlock Text="KeyLayer" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="LastRunText" Style="{StaticResource Caption}" Margin="14,0,8,8" Visibility="Collapsed"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Button x:Name="PauseButton" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left"
                        Padding="14,9" Click="PauseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="StatusText" Text="Shortcuts are on" Margin="12,0,0,0" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem Tag="Shortcuts" IsSelected="True" AutomationProperties.Name="Shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" />
                        <TextBlock Text="Shortcuts" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Keyboards" AutomationProperties.Name="Keyboards">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" />
                        <TextBlock Text="Keyboards" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Test" AutomationProperties.Name="Test keys">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" />
                        <TextBlock Text="Test keys" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Settings" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Text="Settings" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ================================================= pages -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>

                <!-- ============ Shortcuts -->
                <Grid x:Name="ShortcutsPage" Margin="36,30,30,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,6,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Click="AddShortcut_Click"
                                VerticalAlignment="Top" Padding="16,8" Margin="16,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add shortcut" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Shortcuts" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Give any key or Fn combination a new job, on every keyboard or just one." />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel x:Name="FilterPanel" Grid.Row="1" Margin="0,20,0,8" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24">
                        <StackPanel>
                            <ItemsControl x:Name="ShortcutList" ItemTemplate="{StaticResource ShortcutCard}"
                                          Grid.IsSharedSizeScope="True" Focusable="False" />
                            <TextBlock x:Name="FilterEmpty" Style="{StaticResource Body}" Margin="2,8,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="No shortcuts for this keyboard yet. Add one and pick this keyboard in its Keyboard box." />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="ShortcutsEmpty" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center"
                                HorizontalAlignment="Center" MaxWidth="440" Margin="0,0,0,70" Visibility="Collapsed">
                        <Border Style="{StaticResource IconTile}" Width="68" Height="68" CornerRadius="18" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="No shortcuts yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,18,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Body}" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Pick a key or Fn combination and choose what it should do. For shortcuts that never clash with other apps, use your Fn and media keys, or set up a custom Fn key in Settings." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddShortcut_Click" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Add a shortcut" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Content="Test keys" Click="GoTest_Click" Padding="16,8" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ Keyboards -->
                <Grid x:Name="KeyboardsPage" Margin="36,30,30,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,6,20">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Keyboards" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Everything that can send keys to this PC. Press a key and its card lights up." />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24">
                        <StackPanel>
                            <ItemsControl x:Name="KeyboardList" ItemTemplate="{StaticResource KeyboardCard}" Focusable="False" />
                            <Border Style="{StaticResource InfoBar}" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,1,12,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Body}"
                                               Text="A laptop's own keys, including its Fn hotkeys, count as one built-in keyboard. Receivers are mouse dongles that can also send keys. To give a keyboard its own shortcuts, pick it in a shortcut's Keyboard box." />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ Test keys -->
                <Grid x:Name="TestPage" Margin="36,30,30,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,6,0">
                        <Button DockPanel.Dock="Right" Click="ClearEvents_Click" VerticalAlignment="Top" Padding="14,7" Margin="16,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="13" />
                                <TextBlock Text="Clear" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Test keys" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Press any key or Fn combination to see what it sends and which keyboard it came from." />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource InfoBar}" Margin="0,18,6,12">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,1,12,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}"
                                       Text="If an Fn combination shows nothing here, the keyboard handles it itself (usually backlight or lighting), and no app can change it." />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24">
                        <ItemsControl x:Name="EventList" ItemTemplate="{StaticResource EventRow}"
                                      Grid.IsSharedSizeScope="True" Focusable="False" />
                    </ScrollViewer>
                    <StackPanel x:Name="TestEmpty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Body}" Text="Waiting for a key press…" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- ============ Settings -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="36,30,36,36">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="General" />
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                          AutomationProperties.Name="Start with Windows" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="4,0,18,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Starts quietly in the tray when you sign in, so your shortcuts always work." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <CheckBox x:Name="PauseToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Checked="PauseToggle_Changed" Unchecked="PauseToggle_Changed"
                                          AutomationProperties.Name="Pause all shortcuts" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="4,0,18,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="Pause all shortcuts" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Every key does its normal job until you turn this off again." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center"
                                          SelectionChanged="ThemeBox_SelectionChanged" AutomationProperties.Name="Theme">
                                    <ComboBoxItem Content="Use Windows setting" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Margin="4,0,18,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="Theme" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Light, dark, or follow Windows." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Custom Fn key" />
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <ComboBox x:Name="FnBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center"
                                          SelectionChanged="FnBox_SelectionChanged" AutomationProperties.Name="Custom Fn key" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="4,0,18,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="Use a key as your own Fn key" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="Hold it and press another key to run a shortcut. No app uses these combinations, so they never clash with app shortcuts. Pressed on its own, the key does its normal job." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Apps" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="4,0,18,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Body}" Text="Turn shortcuts off in these apps" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="While one of these apps is in front, every key does its normal job, so the app's own shortcuts always work. Handy for games and apps like Premiere Pro or Photoshop." />
                                    </StackPanel>
                                </DockPanel>
                                <local:AppList x:Name="ExcludedAppsList" Margin="38,14,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Help" />
                        <Expander Header="Will my shortcuts clash with other apps' shortcuts?" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="A shortcut takes over its key in every app, and apps don't tell Windows which shortcuts they use. So the shortcut editor tells you when a key is likely to clash. Combinations with your custom Fn key, media keys like Mail, and F13 to F24 never clash. You can also turn shortcuts off in chosen apps: all of them under Apps above, or one at a time in a shortcut's options." />
                        </Expander>
                        <Expander Header="How does the Fn key work?" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Windows never sees the Fn key: the keyboard handles it itself. When you hold Fn and press another key, the keyboard sends a different signal instead, such as Volume Up, Mail or Calculator. KeyLayer listens for those signals and runs your action instead." />
                        </Expander>
                        <Expander Header="Which Fn combinations can I change?" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Any combination that shows up on the Test keys page. Ones that show nothing (usually backlight, lighting effects or a Windows-key lock) are handled entirely inside the keyboard, so no app can change them." />
                        </Expander>
                        <Expander Header="Why do some Fn keys seem to do nothing?" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Many keyboards send signals like Mail, Media Player or Browser Home. Windows only reacts if a default app is set up for them, so they often look broken. They're the best keys to give a new job." />
                        </Expander>
                        <Expander Header="Can the same key do different things on different keyboards?" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Yes. Pick a keyboard in the shortcut's Keyboard box. Windows only says which keyboard a key came from when it's released, so a one-keyboard shortcut on an ordinary key runs when you let go. On the other keyboards the key keeps its normal job (also on release, without auto-repeat). Media keys like volume or Mail react right away." />
                        </Expander>
                        <Expander Header="A combination sends an ordinary key like F5" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Then a shortcut on it also changes F5 when you press it without Fn. Many keyboards have an Fn-lock (often Fn + Esc) that swaps the top row between F1-F12 and the media functions." />
                        </Expander>
                        <Expander Header="Shortcuts don't work in some windows" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Body}" Margin="4,4,4,8"
                                       Text="Windows doesn't let ordinary apps react to keys while an app running as administrator (like Task Manager) is in front. If you need that, run KeyLayer as administrator." />
                        </Expander>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="About" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Image Source="pack://application:,,,/app.ico" Width="40" Height="40" Margin="0,0,16,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrong}" Text="KeyLayer" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Free and open source under the MIT license." />
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Click="GitHub_Click" Padding="14,7" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="13" />
                                            <TextBlock Text="View on GitHub" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenFolder_Click" Padding="14,7" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                                            <TextBlock Text="Open settings folder" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CopyDiagnostics_Click" Padding="14,7" Margin="0,0,8,8"
                                            ToolTip="Copies what KeyLayer can see (keyboards and devices). Handy for bug reports.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                                            <TextBlock x:Name="CopyDiagnosticsText" Text="Copy diagnostics" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="ConfigPathText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
