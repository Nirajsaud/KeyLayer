<Window x:Class="KeyLayer.ShortcutEditor"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add shortcut" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <TextBlock x:Name="Heading" Text="Add shortcut" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!-- ============ 1. key -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="1   Pick a key" Margin="0,20,0,8" />
                <Button x:Name="CaptureButton" Click="Capture_Click" Cursor="Hand" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="Capture a key">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Rectangle x:Name="Dash" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="18,16">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock x:Name="CaptureAction" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        <Grid>
                            <DockPanel x:Name="KeyEmpty">
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock x:Name="KeyEmptyIcon" Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="18"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="KeyPrompt" Style="{StaticResource BodyStrong}" />
                                    <TextBlock x:Name="KeyPromptDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="KeyCaptured" Visibility="Collapsed">
                                <ItemsControl x:Name="KeyCaps" Style="{StaticResource Keycaps}" />
                                <TextBlock x:Name="KeyDetail" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Button>

                <Border x:Name="WarningBar" Style="{StaticResource WarningBar}" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,1,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="WarningText" Style="{StaticResource Body}" />
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Keyboard" Margin="0,18,0,6" />
                <ComboBox x:Name="KeyboardBox" MinWidth="340" HorizontalAlignment="Left"
                          SelectionChanged="KeyboardBox_SelectionChanged" AutomationProperties.Name="Keyboard" />
                <TextBlock x:Name="KeyboardHint" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed" />

                <!-- ============ 2. action -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="2   Choose what it does" Margin="0,26,0,10" />
                <UniformGrid Columns="3" Margin="0,0,-8,0">
                    <RadioButton x:Name="TileOpen" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Open an app, file or website">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE8A7;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Open an app, file or website" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TileShortcut" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Press a key combination">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE765;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Press a key combination" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TileText" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Type some text">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE8D2;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Type some text" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TileMedia" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Media, volume and system">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE8D6;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Media, volume and system" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TileCommand" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Run a command">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE756;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Run a command" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TileOff" Style="{StaticResource Tile}" GroupName="Action" Checked="ActionTile_Checked"
                                 AutomationProperties.Name="Switch the key off">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="&#xE711;" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Switch the key off" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <Grid Margin="0,8,0,0">
                    <StackPanel x:Name="PanelOpen">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="App, file, folder or web address" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Folder…" Click="BrowseFolder_Click" Margin="8,0,0,0" Padding="12,5" />
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFile_Click" Margin="8,0,0,0" Padding="12,5" />
                            <TextBox x:Name="TargetBox" AutomationProperties.Name="App, file, folder or web address" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="For example:  notepad.exe   ·   https://youtube.com   ·   C:\Users\you\Music   ·   ms-settings:display" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments (optional)" Margin="0,14,0,6" />
                        <TextBox x:Name="ArgsBox" AutomationProperties.Name="Arguments" />
                    </StackPanel>

                    <StackPanel x:Name="PanelShortcut" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Key combination to press" />
                        <TextBox x:Name="RecordBox" IsReadOnly="True" Cursor="Hand" FontWeight="SemiBold"
                                 PreviewKeyDown="RecordBox_PreviewKeyDown" PreviewKeyUp="RecordBox_PreviewKeyUp"
                                 AutomationProperties.Name="Key combination to press" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Click the box and press the keys, or build it below." />
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="CtrlBox" Content="Ctrl" Margin="0,0,14,0" Checked="ShortcutPart_Changed" Unchecked="ShortcutPart_Changed" />
                            <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,14,0" Checked="ShortcutPart_Changed" Unchecked="ShortcutPart_Changed" />
                            <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,14,0" Checked="ShortcutPart_Changed" Unchecked="ShortcutPart_Changed" />
                            <CheckBox x:Name="WinBox" Content="Win" Margin="0,0,14,0" Checked="ShortcutPart_Changed" Unchecked="ShortcutPart_Changed" />
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="KeyBox" MinWidth="170" SelectionChanged="ShortcutPart_Changed"
                                      MaxDropDownHeight="360" AutomationProperties.Name="Key" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="PanelText" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Text to type (a new line presses Enter)" />
                        <TextBox x:Name="TypedTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Height="110"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Text to type" />
                    </StackPanel>

                    <StackPanel x:Name="PanelMedia" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Control" />
                        <ComboBox x:Name="BuiltInBox" MinWidth="340" HorizontalAlignment="Left" MaxDropDownHeight="380"
                                  AutomationProperties.Name="Control" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Brightness works on laptop screens; most external monitors ignore it." />
                    </StackPanel>

                    <StackPanel x:Name="PanelCommand" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Command (runs through cmd.exe)" />
                        <TextBox x:Name="CommandBox" AutomationProperties.Name="Command" />
                        <CheckBox x:Name="HideBox" Content="Hide the command window" IsChecked="True" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="For example:  start &quot;&quot; &quot;C:\Games\game.exe&quot;   ·   powershell -NoProfile -Command &quot;…&quot;" />
                    </StackPanel>

                    <StackPanel x:Name="PanelOff" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="The key will do nothing at all." />
                    </StackPanel>
                </Grid>

                <!-- ============ 3. options -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="3   Options" Margin="0,26,0,10" />
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox x:Name="BlockBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                      VerticalAlignment="Center" AutomationProperties.Name="Switch off the key's normal job" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Body}" Text="Switch off the key's normal job" />
                                <TextBlock x:Name="BlockHint" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Style="{StaticResource Body}" Text="Name (optional)" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" AutomationProperties.Name="Name" />
                            <TextBlock x:Name="NamePlaceholder" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Shown on the shortcut's card" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ footer -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                            IsDefault="True" Click="Save_Click" />
                    <Button Content="Cancel" MinWidth="110" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
