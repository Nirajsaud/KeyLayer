<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>KeyLayer.Program</StartupObject>
    <AssemblyName>KeyLayer</AssemblyName>
    <RootNamespace>KeyLayer</RootNamespace>
    <Product>KeyLayer</Product>
    <Version>1.2.2</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- A tray app: no background GC thread, and keep the heap small rather than fast to grow -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental -->
    <!-- WFO0003: WinForms would set DPI awareness in code; this is a WPF app, which uses the manifest -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- The UI is WPF; WinForms is only used for the tray icon and a message-only window. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
