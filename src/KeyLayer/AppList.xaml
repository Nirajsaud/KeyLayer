<UserControl x:Class="KeyLayer.AppList"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl x:Name="Items" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="12,5,5,5" Margin="0,0,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="Remove_Click" Padding="9,7"
                                    ToolTip="Remove" AutomationProperties.Name="{Binding RemoveLabel}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                            </Button>
                            <Grid Width="20" Height="20" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding GlyphVisibility}" />
                                <Image Source="{Binding Icon}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Exe}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Left" Click="Add_Click" Padding="12,6" AutomationProperties.Name="Add app">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                <TextBlock Text="Add app" Margin="8,0,0,0" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
